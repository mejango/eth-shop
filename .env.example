NEXT_PUBLIC_SITE_URL=http://localhost:3003
NEXT_PUBLIC_BENDYSTRAW_URL=https://bendystraw.up.railway.app
NEXT_PUBLIC_TESTNET_BENDYSTRAW_URL=https://testnet.bendystraw.xyz
# Set to 1 to also show testnet shops.
NEXT_PUBLIC_TESTNET=
# RPC reads default to juicebox.center. Set NEXT_PUBLIC_RPC_<chainId> only to
# override it with your own comma-separated HTTPS endpoints for that chain.
NEXT_PUBLIC_RPC_1=
NEXT_PUBLIC_RPC_8453=
NEXT_PUBLIC_RPC_10=
NEXT_PUBLIC_RPC_42161=
NEXT_PUBLIC_IPFS_GATEWAY=https://juicebox.center/ipfs/
NEXT_PUBLIC_PARA_API_KEY=beta_bfd2fb77a3fc475f00918565f2f863e3
NEXT_PUBLIC_PARA_ENV=BETA
# Which Para on-ramp provider the headless "Get ETH" call bills through.
# Must be one live in the Para dashboard: STRIPE | MOONPAY | RAMP | CDP | MERCURYO.
NEXT_PUBLIC_PARA_ONRAMP_PROVIDER=STRIPE
# WalletConnect Cloud project id. Leave empty to hide the WalletConnect
# option entirely — the relay rejects unregistered ids, so a connector
# without one is a button that always fails.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
# Immutable release identifier, normally the Railway/Git commit SHA.
NEXT_PUBLIC_VERSION=development
# Set to "true" only for deterministic browser test builds; blocked in
# deployment builds. Routes RPC reads through NEXT_PUBLIC_RPC_FIXTURE_URL.
NEXT_PUBLIC_DETERMINISTIC_BROWSER=
# RPC endpoint used in place of live chains when NEXT_PUBLIC_DETERMINISTIC_BROWSER
# is "true". Ignored otherwise.
NEXT_PUBLIC_RPC_FIXTURE_URL=
