{
  "name": "eth-shop",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "26.5.x",
    "npm": "12.0.x"
  },
  "scripts": {
    "dev": "next dev --webpack -p 3003",
    "build": "npm run env:check:build && next build --webpack",
    "start": "npm run env:check:runtime && next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "env:check:build": "node --env-file-if-exists=.env.local scripts/validate-env.mjs build",
    "env:check:runtime": "node --env-file-if-exists=.env.local scripts/validate-env.mjs runtime",
    "env:test": "node scripts/test-validate-env.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run env:test && npm run build",
    "format:write": "prettier --write \"**/*.{js,jsx,mjs,ts,tsx,json,css}\""
  },
  "dependencies": {
    "@bananapus/nana-sdk-core": "^2.4.0",
    "@coinbase/wallet-sdk": "4.3.7",
    "@getpara/react-component-library": "3.11.0",
    "@getpara/react-sdk-lite": "3.11.0",
    "@getpara/wagmi-v2-connector": "3.11.0",
    "@getpara/web-sdk": "3.11.0",
    "@safe-global/safe-apps-provider": "^0.18.6",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "@tanstack/react-query": "5.101.4",
    "@wagmi/core": "3.6.4",
    "@walletconnect/ethereum-provider": "2.23.10",
    "next": "16.2.11",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.55.8",
    "wagmi": "3.7.4"
  },
  "overrides": {
    "@walletconnect/jsonrpc-ws-connection": {
      "ws": "7.5.13"
    },
    "axios": "1.18.1",
    "nanoid": "3.3.18",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.7.0",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.9"
  },
  "packageManager": "npm@12.0.1"
}
